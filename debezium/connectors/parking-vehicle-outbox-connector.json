{
  "name": "parking-vehicle-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.mariadb.MariaDbConnector",

    "database.hostname": "${DEBEZIUM_DB_HOST}",
    "database.port": "${DEBEZIUM_DB_PORT}",
    "database.user": "${DEBEZIUM_DB_USER}",
    "database.password": "${DEBEZIUM_DB_PASSWORD}",

    "topic.prefix": "parking-cdc",

    "database.include.list": "my_parking",
    "table.include.list": "my_parking.outbox",
    "include.schema.changes": "false",

    "snapshot.mode": "no_data",
    "snapshot.locking.mode": "none",
    "database.server.id": "184059",
    "database.ssl.mode": "disabled",

    "schema.history.internal.kafka.bootstrap.servers": "kafka-broker:9092",
    "schema.history.internal.kafka.topic": "schema-history.parking-cdc",

    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.type": "event_type",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.route.by.field": "topic",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.fields.additional.placement": "event_type:header:eventType",
    "transforms.outbox.table.op.invalid.behavior": "warn",

    "tombstones.on.delete": "false",

    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "outbox-dlq",
    "errors.deadletterqueue.context.headers.enable": "true",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.storage.StringConverter"
  }
}
